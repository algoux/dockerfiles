FROM node:22.23.4-bookworm

ARG DEBIAN_FRONTEND=noninteractive
ARG JEMALLOC_VERSION=5.3.0
USER root
RUN wget -qc https://github.com/jemalloc/jemalloc/releases/download/${JEMALLOC_VERSION}/jemalloc-${JEMALLOC_VERSION}.tar.bz2 -O - | tar -C /tmp -jx \
  && cd /tmp/jemalloc-${JEMALLOC_VERSION} \
  && ./configure \
  && make \
  && make install \
  && rm -rf /tmp/jemalloc-${JEMALLOC_VERSION}
ENV LD_PRELOAD=/usr/local/lib/libjemalloc.so.2

RUN apt-get update && apt-get install -y vim curl telnet dnsutils \
  && apt-get clean && rm -rf /var/lib/apt/lists/*

# Verify the actual runtime for every target architecture before publishing.
RUN node -e 'const assert = require("node:assert/strict"); const zlib = require("node:zlib"); assert.equal(process.versions.node, "22.23.4"); assert.equal(typeof zlib.constants.BROTLI_DECODER_ERROR_FORMAT_BLOCK_SWITCH, "number"); const input = Buffer.from("nodebase Brotli smoke test"); assert.deepEqual(zlib.brotliDecompressSync(zlib.brotliCompressSync(input)), input); console.log("Verified Node " + process.versions.node + " with the October 2026 Brotli fix on " + process.arch);'
